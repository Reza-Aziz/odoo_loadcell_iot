<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_iot" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.iot</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Tombol di header form -->
            <xpath expr="//header" position="inside">
                <button name="action_get_iot_weight"
                        string="Ambil Berat IoT"
                        type="object"
                        class="oe_highlight"/>
            </xpath>

            <!-- Field berat IoT -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="iot_net_weight"/>
                <field name="iot_latest_weight" readonly="1"/>
                <field name="iot_latest_time" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
